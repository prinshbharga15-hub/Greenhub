# Server & Database Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
# For MongoDB Atlas Cloud Cluster, use:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/greenhub?retryWrites=true&w=majority
DB_NAME=greenhub

# Security & API Keys
BRIDGE_API_KEY=your_secure_bridge_api_key_here

# Admin Default Credentials
ADMIN_NAME=GreenHub Admin
ADMIN_EMAIL=admin@greenhub.com
